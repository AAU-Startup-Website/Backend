# Copy to .env and fill in values. Never commit real secrets.
DEBUG=True
SECRET_KEY=some-long-random-string-for-development

# Hosts / CORS (comma-separated, no wildcards)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Database (local) — or use DATABASE_URL instead
DB_NAME=startup_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/startup_portal

# Auth / lockout
AUTH_TOKEN_EXPIRY_HOURS=24
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=30

# Public frontend (Next.js) should set:
# NEXT_PUBLIC_API_URL=http://localhost:8000
